# Ignore — §10 Day 1: не подcommitи local artifacts (token, SQLite DB, Go cache)
.env
.env.*
!.env.example
data/
*.db
*.db-wal
*.db-shm
bin/
*.exe
.cache/
*.log

# PLAN.md — planning document, stays local (not committed; README links §7)
PLAN.md
docs/PLAN.md

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
*.orig
*.tmp
.vscode/
.idea/

# Go/test artifacts and local secrets that must never be committed
*.test
*.out
*.prof
coverage.out
coverage.html
*.key
*.pem

# scratch — local verification output (env-setting scripts, run logs), never committed
zzscratch/

# Docker secrets — local runtime files created by scripts/setup_docker_secrets.*; only the placeholder is tracked.
# Never commit real values: `docker compose` reads secrets/telegram_bot_token and secrets/strata_api_key directly.
secrets/*
!secrets/.gitkeep
