# Конфигурация (ENV) — §7 table "Конфигурация (ENV)" of PLAN.md, verbatim.
# The loader is internal/config (bot/internal/config.Load): it reads the process
# ENV once, takes exactly the supported names, and a copy of this file to .env is
# the only way to feed it (no config file exists — the token comes from the ENV or from
# a *_FILE secret mount, and .env is listed in .gitignore).
#
# Secrets may also arrive as a FILE instead of an environment value, for Docker secrets, systemd credentials or
# a mounted Kubernetes secret: TELEGRAM_BOT_TOKEN_FILE, STRATA_API_KEY_FILE, WEBHOOK_SECRET_TOKEN_FILE. The path
# must be absolute, the file is read once at start (at most 4 KiB, trailing newline trimmed), and setting both
# the row and its _FILE spelling is refused as a configuration problem.
#
# §7 behaviour: the absence of TELEGRAM_BOT_TOKEN = a clear error on the start and
# exit code 1 (§10 День 1 DoD). §16 change 25: the loader collects EVERY broken row
# into one list and the process refuses to start while the list is not empty — a bad
# row is never silently replaced by a default, because a half-configured bot that
# looks alive is worse than one that names the row it cannot read.
#
# The bounds and the fallback values inside internal/config are the safety net of the
# loader, not a production behaviour: a value outside its range is reported by name.
#
# §7 URL rule (§16 change 8): STRATA_BASE_URL is stored WITHOUT the "/v1" suffix;
# the client joins {base}/chat/completions and {base}/models. If you write ".../v1"
# anyway, the loader cuts the suffix — the join can never produce "/v1/v1/...".

TELEGRAM_BOT_TOKEN=
STRATA_BASE_URL=http://host.docker.internal:8000
STRATA_MODEL=qwen2.5-7b-instruct
# Резервная модель: пусто = fallback выключен. Если задана, запрос один раз повторяется на неё после
# retryable-ошибки основной (5xx, 429, transient error внутри стрима или сетевая ошибка). 400/401/404 и
# ошибки разбора не повторяются. Стрим, уже отдавший хотя бы один delta, не переигрывается — дубля нет.
STRATA_FALLBACK_MODEL=
# Отдельный endpoint резервной модели: пусто = тот же STRATA_BASE_URL. Непустое значение обязано быть
# absolute http(s) URL без userinfo. Та же модель на том же endpoint не поможет и отклоняется загрузчиком.
STRATA_FALLBACK_BASE_URL=
# STRATA_FALLBACK_API_KEY — key for a reserve endpoint that is not the primary; empty means STRATA_API_KEY.
STRATA_FALLBACK_API_KEY=
# STRATA_FALLBACK_TIMEOUT_SECONDS — per-attempt timeout of the reserve endpoint. A reserve model may load on demand;
# a 27B model on LM Studio took about 61 s cold, hence the default 120 s. The outer reply budget still bounds the answer.
STRATA_FALLBACK_TIMEOUT_SECONDS=120
# STRATA_FALLBACKS — ordered reserve chain (JSON, up to 8). Mutually exclusive with STRATA_FALLBACK_MODEL.
# Example: [{"model":"kimi-k3.1-pro","base_url":"https://api.moonshot.ai/v1","api_key":"sk-...","timeout_seconds":120},
#           {"model":"local-reserve"}]
STRATA_FALLBACKS=
# MODEL_PROVIDERS — named OpenAI-compatible endpoints (JSON, up to 6) a chat can pick with
# /model select <name:model> and in the Mini App settings. Empty or missing = no named provider.
# Entry: {name, base_url, api_key?, models, default_model?, timeout_seconds?}.
#   name           unique, lower-case [a-z0-9_-]+; "strata" is reserved for the primary endpoint.
#   base_url       absolute http(s) URL without userinfo; /v1 is normalized exactly like STRATA_BASE_URL.
#   models         1..20 unique model ids; the provider serves only these, an unlisted id is refused.
#   default_model  optional, must be one of models; the first model when omitted.
#   timeout_seconds 5..600, default 120.
# A provider with an empty api_key on a third-party host is skipped at startup with a WARN. A local endpoint
# (LM Studio style: host.docker.internal, localhost, a private IP or a dotless name) works without a key.
# DeepSeek has no key here, so its entry stays inactive until api_key is set. A single legacy "model" string
# is accepted as a one-element models list.
# Example: [{"name":"kimi","base_url":"https://api.moonshot.ai/v1","api_key":"sk-...","models":["kimi-k3.1-pro","kimi-k2.6"],"default_model":"kimi-k3.1-pro","timeout_seconds":120},
#           {"name":"deepseek","base_url":"https://api.deepseek.com/v1","api_key":"","models":["deepseek-chat"]}]
MODEL_PROVIDERS=
# MODEL_PRICES — цены моделей в USD за миллион токенов (JSON, до 100 записей). Пусто = все цены 0:
# /api/usage показывает cost_usd = 0, а дневной бюджет стоимости чата не применяется.
# Entry: {model, input_per_mtok_usd, output_per_mtok_usd, provider?}.
#   model  непустой id; допускается "provider:model" или отдельное поле provider.
#   provider  необязателен, обязан быть именем из MODEL_PROVIDERS; без него цена действует для этой
#             модели у любого провайдера.
#   input_per_mtok_usd/output_per_mtok_usd  от 0 до 10000 включительно.
# Ключи (provider + model) уникальны; одна неверная запись отклоняет весь список. Стоимость считается
# по сохранённым tokens_in/tokens_out ответов ассистента: input×input_price + output×output_price,
# в USD с 6 знаками (микродоллары). Цены не хранятся в БД и применяются к уже сохранённым сообщениям.
# Example: [{"model":"deepseek-flash","input_per_mtok_usd":0.27,"output_per_mtok_usd":1.10,"provider":"deepseek"}]
MODEL_PRICES=
# Модель для POST /v1/audio/transcriptions; пусто = Systran/faster-whisper-small.
STRATA_TRANSCRIPTION_MODEL=
# Отдельный transcription endpoint; пусто = STRATA_BASE_URL. В compose по умолчанию Whisper sidecar.
TRANSCRIPTION_BASE_URL=
# Opt-in /tts через POST {TRANSCRIPTION_BASE_URL}/v1/audio/speech; false по умолчанию.
TTS_ENABLED=false
TTS_MODEL=speaches-ai/piper-ru_RU-ruslan-medium
TTS_VOICE=ruslan
TTS_MAX_CHARS=1000
TTS_TIMEOUT_SECONDS=60
STRATA_API_KEY=
STRATA_TIMEOUT_SECONDS=60
TG_REPLY_DEADLINE_SECONDS=90
# Task steps get their own budgets: one model call may take minutes with web search on a local model.
# TASK_AUTO_APPROVE_NETWORK — execute read_url/web_search inside a read-only task without a per-call button.
TASK_AUTO_APPROVE_NETWORK=false
TASK_MODEL_TIMEOUT_SECONDS=240
TASK_STEP_DEADLINE_SECONDS=300
# Автоматический recovery только для unanswered-вопросов не старше 24 часов; 0 отключает age cap.
RECOVERY_MAX_AGE_HOURS=24
# Общий лимит фото/альбома и speech-файла; длительность voice/audio/video note.
# Этот же лимит задаёт HTTP-cap загрузки документа в Mini App (MEDIA_MAX_MB + 64 КиБ multipart-overhead);
# сам текст по-прежнему ограничен 64 КиБ, как /docs add.
MEDIA_MAX_MB=10
SPEECH_MAX_SECONDS=300
# §15 «стриминг ответов» — the four rows of §16 change 34.
# STREAMING_ENABLED=false is the default on purpose: a streamed answer rewrites ONE Telegram message while the
# model writes it, which changes how every answer of §12 UX looks, so the operator turns it on deliberately
# rather than getting it from a deploy.
# STREAM_EDIT_INTERVAL_MS — how often that message may be rewritten. Measured on §14 (zzscratch/streamprobe):
# the model emits ~48 SSE events per second, ~20 ms apart, while Telegram tolerates roughly one edit per second
# per chat (§10 День 4, events kind='flood').
# STREAM_IDLE_TIMEOUT_SECONDS — the pause between two SSE events past which the stream is considered dead. The
# measured gap inside a healthy answer is ~20 ms, so this never fires on a working model; it fires on a stall.
# STREAM_TOTAL_DEADLINE_SECONDS — the ceiling of one streamed answer, thinking included. The GPU is bounded by
# MAX_CONCURRENT_MODEL_REQUESTS (§12), so an answer that never ends is a failure mode, not a feature.
# The loader refuses two combinations (§10 День 1 validation): STREAM_TOTAL_DEADLINE_SECONDS not greater than
# STREAM_IDLE_TIMEOUT_SECONDS (a stall detector may not outlive the answer it watches), and with the flag on,
# TG_REPLY_DEADLINE_SECONDS not greater than STREAM_IDLE_TIMEOUT_SECONDS — the answer must START arriving
# inside the reply budget, which is the promise «сообщение не зависает» of §12 UX.
STREAMING_ENABLED=false
STREAM_EDIT_INTERVAL_MS=5000
STREAM_IDLE_TIMEOUT_SECONDS=30
STREAM_TOTAL_DEADLINE_SECONDS=900
# STREAM_DRAFTS_ENABLED — private-chat streaming through Bot API draft messages instead of editing a
# placeholder. Off by default: a draft keeps the position where the answer started, so if the next question
# arrives while the answer is still being produced, the finished message can appear ABOVE that question. The
# dispatcher already sends such an answer as a new message below the newer question, but the draft preview
# itself cannot be removed from the chat, so the preview stays until Telegram expires it. Turn it on only if
# you accept that trade-off.
STREAM_DRAFTS_ENABLED=false
# §15 webhooks are opt-in. Long polling stays the default. HTTPS terminates at a reverse proxy/tunnel;
# the public path must exactly match WEBHOOK_PATH, and the secret is checked on every Telegram POST.
WEBHOOK_ENABLED=false
WEBHOOK_PUBLIC_URL=
WEBHOOK_SECRET_TOKEN=
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_PORT=8082
WEBHOOK_PATH=/telegram/webhook
# Opt-in read-only Telegram Mini App. HTTPS terminates at a reverse proxy/tunnel; the HTTP listener is loopback-only.
MINIAPP_ENABLED=false
# MINIAPP_TELEGRAM_FALLBACK — global default: if the Mini App window is closed before the answer's done event,
# deliver the already generated answer to the Telegram chat (default true: an answer that was paid for should
# reach the user). Per chat, /miniapp on|off|reset in Telegram and the Mini App Settings toggle override it.
MINIAPP_TELEGRAM_FALLBACK=true
MINIAPP_LISTEN_HOST=127.0.0.1
MINIAPP_PORT=8084
MINIAPP_PUBLIC_URL=
DB_PATH=./data/bot.db
# IANA timezone for /remind daily wall-clock scheduling; default UTC.
REMINDER_TIMEZONE=UTC
CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=8000
MAX_INPUT_CHARS=4000
RAG_MAX_DOCUMENTS=20
RAG_RESULT_LIMIT=3
RAG_MAX_CONTEXT_CHARS=2000
# Гибридный RAG: embeddings + FTS5. По умолчанию выключен; при true запрос и новые документы считаются через
# OpenAI-compatible POST {base}/embeddings. Base URL должен уже включать /v1, как у любого OpenAI-совместимого
# сервера. В Docker хост-сервер доступен как host.docker.internal: compose уже добавляет
# `extra_hosts: host.docker.internal:host-gateway`; ручному контейнеру нужен
# `--add-host host.docker.internal:host-gateway`. Модель по умолчанию — nomic-embed-text v1.5 (768 измерений).
# Уже сохранённые документы заполняет backfill: go run ./cmd/ragembed -path <db> -base-url <url> (см. README).
# При RAG_EMBEDDINGS_ENABLED=true base URL обязан быть absolute http(s), а модель — непустой.
RAG_EMBEDDINGS_ENABLED=false
RAG_EMBEDDINGS_BASE_URL=http://host.docker.internal:1234/v1
RAG_EMBEDDINGS_MODEL=text-embedding-nomic-embed-text-v1.5
# Timeout одного embedding-запроса; 1..120.
RAG_EMBEDDINGS_TIMEOUT_SECONDS=10
SYSTEM_PROMPT=You are a helpful assistant.
TELEGRAM_ALLOWED_USERS=
# Административные агрегированные метрики доступны только этим user id; пусто = никому.
TELEGRAM_ADMIN_USERS=
RATE_LIMIT_PER_MINUTE=20
# Персональные лимиты за UTC-сутки; 0 = без ограничений. Network tools: read_url + web_search.
USER_DAILY_MODEL_LIMIT=0
USER_DAILY_NETWORK_TOOL_LIMIT=0
# Необязательные override по positive user id; поля model/network_tools, значения 0..1000000.
USER_LIMITS_JSON={}
MAX_CONCURRENT_MODEL_REQUESTS=2
PROXY_FREE_TEXT=true
# Безопасный calculator tool; false отключает function calling.
TOOLS_ENABLED=true
# Opt-in read_url для текстовых HTTPS-страниц; false по умолчанию. URL/content не логируются.
URL_READER_ENABLED=false
# Opt-in web_search через self-hosted SearxNG; false по умолчанию. Tool предлагается модели только вместе
# с TOOLS_ENABLED=true. Бот вызывает {WEB_SEARCH_BASE_URL}/search?q=…&format=json и не загружает сами
# результаты, поэтому ссылки выдачи не участвуют в SSRF. В compose адрес sidecar — http://searxng:8080.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_BASE_URL=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=5
MAX_MESSAGE_CHUNK=3500
PARSE_MODE=MarkdownV2
# HEALTH_PORT — canonical value for this deployment is 8081: edge-gateway's Prometheus scrapes bot:8081 (the
# two files are CI-checked), and the live .env already uses it. This is now the METRICS port: the listener
# binds only METRICS_LISTEN_HOST (see below) inside the container. It is also the HOST port of the published
# health URL (127.0.0.1:8081 -> container HEALTH_PROBE_PORT), so existing scripts and `curl /healthz` keep
# working. A host process on 8081 still blocks `docker compose up`.
HEALTH_PORT=8081
# HEALTH_LISTEN_HOST — where the /healthz and /readyz listener binds; it never serves /metrics when
# METRICS_LISTEN_HOST is set. Default 127.0.0.1. Compose sets 0.0.0.0 so the HEALTHCHECK (127.0.0.1), the
# host-published health URL and Docker's health state work; the publish rule stays 127.0.0.1, so the host side
# is never exposed to the network. Accepted: 127.0.0.1, ::1, 0.0.0.0.
HEALTH_LISTEN_HOST=127.0.0.1
# HEALTH_PROBE_PORT — in-container port of /healthz,/readyz. Compose pins 8080 (the host publishes
# 127.0.0.1:${HEALTH_PORT} -> container 8080). Leave it UNSET outside compose: then the probe listener reuses
# HEALTH_PORT and /metrics stays on the same listener, exactly as before.
# HEALTH_PROBE_PORT=8080
# METRICS_LISTEN_HOST — a concrete loopback/private IP for the /metrics listener. When set, /metrics moves
# off the health listener to <METRICS_LISTEN_HOST>:${HEALTH_PORT}, and HEALTH_PROBE_PORT is required. Compose
# sets it to the bot's static address on the edge-monitoring network, so only Prometheus (also on that
# network) can scrape. 0.0.0.0 is refused on purpose: it would expose metrics on default/edge-telegram again.
# METRICS_LISTEN_HOST=127.0.0.1
# METRICS_LISTEN_HOST_CONTAINER — compose-only value that fills both METRICS_LISTEN_HOST and the bot's
# ipv4_address on edge-gateway_edge-monitoring. Change it if the gateway recreates that network with another
# subnet; it must be a free address of that subnet. The default 172.24.0.250 matches the current subnet.
METRICS_LISTEN_HOST_CONTAINER=172.24.0.250
LOG_LEVEL=info

# TELEGRAM_BOT_TOKEN and STRATA_API_KEY stay empty here on purpose: they are
# secrets (§12 security, §14.1 item 1 — the token of BotFather never enters a
# commit or the chat; the leak check before a commit is mandatory).
# TELEGRAM_ALLOWED_USERS empty = closed bot, deny by default (§7, §16 change 13): only
# /start and /whoami answer, everything else goes to events(kind='denied').
# This is the only spelling the loader reads (§16 change 29): the row used to be named ALLOWED_USER_IDS in
# the §7 table of the plan, but a real .env carries the Telegram-style name, so THAT became the row and the
# old one left the loader — writing ALLOWED_USER_IDS=… now stops the start with a message that names the
# new name instead of leaving a closed bot that looks configured (§12 reliability).
# /whoami prints the numeric user_id to write here (id@username in BotFather is not it, §14.1).
# TELEGRAM_ALLOWED_USERS=123456789
# DB_PATH: the default is a local Windows path for run.ps1 (§16 change 9);
# compose overrides it with /data/bot.db and the named volume bot-data:/data is
# mandatory (§8.1, §19 risk: WAL on a Windows bind-mount risks corruption).
# MAX_MESSAGE_CHUNK counts SYMBOLS, not bytes (§12 UX, §16 change 7: the Telegram
# limit is 4096 symbols, кириллица costs two bytes, the cut goes by runes);
# the loader refuses a value above 4096.
# TG_REPLY_DEADLINE_SECONDS must be greater than STRATA_TIMEOUT_SECONDS (§7 rows,
# §10 День 3 invariant): retries + timeout + answer into Telegram share the budget.
# PARSE_MODE: MarkdownV2 | HTML | plain (§6, §16 change 12).
# LOG_LEVEL: error | warning | info | debug (§12 security: at info the full texts
# of the model requests never enter the log).
# The v1.0 rows (LLM_CHAT_*, the token budgets, the deep link, PORT, DB_DB*) are
# not rows of §7 v1.1 — they moved to the §15 backlog (§16 change 25.1); the
# loader refuses them by name and points at the §7 table.
# DEFAULT_LANGUAGE — ru|en for new chats; /language overrides it per chat.
DEFAULT_LANGUAGE=ru
# GROUPS_ENABLED — answer in groups only on a mention or a reply to the bot.
GROUPS_ENABLED=false
