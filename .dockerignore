# .dockerignore — keep local state, tooling and scratch packages out of the release build context.
.git/
.github/
.gitlab-ci.yml
scripts/
.env
.env.*
!.env.example
# Local Docker secret files must never enter the build context (the builder stage runs COPY . .).
secrets/
.cache/
zzscratch/
bin/
data/
docs/
PLAN.md
*.db
*.db-wal
*.db-shm
*.log
*.exe
README.md
