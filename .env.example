# Конфигурация (ENV) — §7 table "Конфигурация (ENV)" of PLAN.md, verbatim.
# The loader is internal/config (bot/internal/config.Load): it reads the process
# ENV once, takes exactly the 19 names of §7, and a copy of this file to .env is
# the only way to feed it (no config file exists — §12 security keeps the token
# only in the ENV, and .env is listed in .gitignore).
#
# §7 behaviour: the absence of TELEGRAM_BOT_TOKEN = a clear error on the start and
# exit code 1 (§10 День 1 DoD). §7.2, §16 change 24: the loader collects EVERY
# broken row into one list — a bad row falls back to the §7 default, the good
# values stay in the Config, so one typo never blinds the whole configuration.
#
# §7 URL rule (§16 change 8): STRATA_BASE_URL is stored WITHOUT the "/v1" suffix;
# the client joins {base}/chat/completions and {base}/models. If you write ".../v1"
# anyway, the loader cuts the suffix — the join can never produce "/v1/v1/...".

TELEGRAM_BOT_TOKEN=
STRATA_BASE_URL=http://host.docker.internal:8000
STRATA_MODEL=qwen2.5-7b-instruct
STRATA_API_KEY=
STRATA_TIMEOUT_SECONDS=60
TG_REPLY_DEADLINE_SECONDS=90
DB_PATH=./data/bot.db
CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=8000
MAX_INPUT_CHARS=4000
SYSTEM_PROMPT=You are a helpful assistant.
TELEGRAM_ALLOWED_USERS=
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_MODEL_REQUESTS=2
PROXY_FREE_TEXT=true
MAX_MESSAGE_CHUNK=3500
PARSE_MODE=MarkdownV2
HEALTH_PORT=8080
LOG_LEVEL=info

# TELEGRAM_BOT_TOKEN and STRATA_API_KEY stay empty here on purpose: they are
# secrets (§12 security, §14.1 item 1 — the token of BotFather never enters a
# commit or the chat; the leak check before a commit is mandatory).
# TELEGRAM_ALLOWED_USERS empty = closed bot, deny by default (§7, §16 change 13): only
# /start and /whoami answer, everything else goes to events(kind='denied').
# This is the only spelling the loader reads (§16 change 29): the row used to be named ALLOWED_USER_IDS in
# the §7 table of the plan, but a real .env carries the Telegram-style name, so THAT became the row and the
# old one left the loader — writing ALLOWED_USER_IDS=… now stops the start with a message that names the
# new name instead of leaving a closed bot that looks configured (§12 reliability).
# /whoami prints the numeric user_id to write here (id@username in BotFather is not it, §14.1).
# TELEGRAM_ALLOWED_USERS=123456789
# DB_PATH: the default is a local Windows path for run.ps1 (§16 change 9);
# compose overrides it with /data/bot.db and the named volume bot-data:/data is
# mandatory (§8.1, §19 risk: WAL on a Windows bind-mount risks corruption).
# MAX_MESSAGE_CHUNK counts SYMBOLS, not bytes (§12 UX, §16 change 7: the Telegram
# limit is 4096 symbols, кириллица costs two bytes, the cut goes by runes);
# the loader refuses a value above 4096.
# TG_REPLY_DEADLINE_SECONDS must be greater than STRATA_TIMEOUT_SECONDS (§7 rows,
# §10 День 3 invariant): retries + timeout + answer into Telegram share the budget.
# PARSE_MODE: MarkdownV2 | HTML | plain (§6, §16 change 12).
# LOG_LEVEL: error | warning | info | debug (§12 security: at info the full texts
# of the model requests never enter the log).
# The v1.0 rows (LLM_CHAT_*, the token budgets, the deep link, PORT, DB_DB*) are
# not rows of §7 v1.1 — they moved to the §15 backlog (§16 change 25.1); the
# loader refuses them by name and points at the §7 table.

