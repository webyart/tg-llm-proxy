# tg-llm-proxy — ENV-variabler (§7)
# Required:
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# STRATA_MODEL — required, no default (plan §7; wrong model → HTTP 400, bot logropruning)
STRATA_MODEL=qwen2.5-7b-instruct

# STRATA — default = host.docker.internal (for Linux server: sed -i 's/127.0.0.1/localhost:8000/' /etc/strata/server/config.json; §11)
STRATA_BASE_URL=http://host.docker.internal:8000

# DB_PATH — default ./data/bot.db (Docker bind mount: ./data → /app/data inside container, §11)
DB_PATH=./data/bot.db

# Allowed user IDs (comma-separated, — `!` = banlist; empty = free-for-all, startup warning; §11)
ALLOWED_USER_IDS=

# Advanced — defaults are OK
STRATA_API_KEY=
REPLY_DEADLINE_SECONDS=90
STRATA_TIMEOUT_SECONDS=60
CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=8000
MAX_INPUT_CHARS=4000
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_MODEL_REQUESTS=2
SYSTEM_PROMPT=You are a helpful assistant. Answer briefly.
PROXY_FREE_TEXT=true
MAX_MESSAGE_CHUNK=3500
HEALTH_PORT=8080
LOG_LEVEL=info
